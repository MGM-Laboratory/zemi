{
  "name": "zemi",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "e2e": "playwright test",
    "e2e:quick": "playwright test --grep-invert \"@stream|@camera\""
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "^3.7.4",
    "railway": "^3.11.0",
    "turbo": "^2.8.18"
  }
}
