{
  "//": "Editor and tsc support only; Playwright transpiles the specs itself. Check with: packages/shared/node_modules/.bin/tsc -p e2e",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "typeRoots": ["../apps/api/node_modules/@types"]
  },
  "include": ["./**/*.ts", "../playwright.config.ts"]
}
