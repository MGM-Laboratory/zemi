# Zemi API environment. Copy to apps/api/.env for local dev (real env vars always win).
# Validated at boot by src/config/env.ts: the API refuses to start and lists every problem.

NODE_ENV=development
PORT=4400
# "::" listens on IPv6 + IPv4 (Railway private networking needs IPv6).
HOST=::
# Express trust proxy: true, false, a hop count, or subnets. Railway sits in front of us.
TRUST_PROXY=true
# Header with the real client IP (rate limits, audit). Railway's edge sets X-Real-IP; clients
# can't forge it the way they can prepend to X-Forwarded-For. "none" falls back to req.ip.
CLIENT_IP_HEADER=x-real-ip

# The web app origin (cookies + CORS with credentials). Extra origins: comma separated.
WEB_ORIGIN=http://localhost:3300
CORS_ORIGINS=

DATABASE_URL=postgres://zemi:zemi@localhost:55440/zemi
DATABASE_POOL_MAX=10
# Apply apps/api/drizzle migrations before boot.
MIGRATE_ON_BOOT=true

# Required. At least 12 characters. Logs you in as the superadmin.
SUPERADMIN_PASSPHRASE=change-me-to-a-long-friday-passphrase
# Required. 32+ random characters (HMAC pepper, token signing, AES key derivation).
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
APP_SECRET=

# Absolute bases for URLs we hand out (media/HLS) and links in emails/QR codes.
PUBLIC_API_URL=http://localhost:4400
PUBLIC_WEB_URL=http://localhost:3300

# S3-compatible bucket (MinIO locally, Railway Bucket in prod). Private: served via /media/*.
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=zemi
S3_ACCESS_KEY_ID=zemi
S3_SECRET_ACCESS_KEY=zemi-secret
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true

# Empty => emails are rendered to apps/api/.mail-outbox/*.html and logged with status "logged".
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=
MAIL_FROM="Zemi <no-reply@labmgm.org>"
MAIL_REPLY_TO=
# MAIL_OUTBOX_DIR=/tmp/zemi-mail-outbox

# MediaMTX (apps/media). The secret is shared with the media server's auth hook and HLS bearer.
MEDIA_INTERNAL_SECRET=dev-media-secret
MEDIA_HLS_URL=http://localhost:58888
MEDIA_API_URL=http://localhost:59997
# What admins paste into OBS "Server".
RTMP_PUBLIC_URL=rtmp://localhost:51935/live

# Web cache revalidation (POST { secret, tags } after content changes).
WEB_REVALIDATE_URL=http://localhost:3300/api/revalidate
REVALIDATE_SECRET=dev-revalidate

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Max upload size in bytes (default 4 GiB).
# UPLOAD_MAX_BYTES=4294967296
# Run pg-boss workers in this process (sending jobs always works).
# JOBS_ENABLED=true
# Swagger UI at /api/docs (defaults to on outside production).
# SWAGGER=true
